# 基础镜像默认用官方源。国内网络拉不动 Docker Hub 时，复制本文件为 .env，
# 并把 REGISTRY 改成镜像加速地址（注意必须以 / 结尾）：
#   REGISTRY=docker.m.daocloud.io/
#
# Docker Compose 会自动读取同目录下的 .env，不需要改任何文件。
REGISTRY=

# 宿主端口。默认值是特意避开常见占用的：
#   MySQL 13306（不是 3306，因为很多开发机本地已经跑着 MySQL）
#   Redis 16379 / 计数 Redis 16380（同上）
#   RocketMQ NameServer 19876
# 都空闲的话可以改成标准端口。
MYSQL_PORT=13306
REDIS_PORT=16379
COUNTERS_PORT=16380
MQ_NAMESRV_PORT=19876
APP_PORT=8080
